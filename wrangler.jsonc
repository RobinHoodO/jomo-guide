{
  "name": "jomo-guide",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "ratelimits": [
    { "name": "SESSION_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
